---
import type { Entry } from '../lib/content';
import { entryUrl, formatDate, readingTime } from '../lib/content';
import Icon from './Icon.astro';
interface Props {
  entry: Entry;
  visual?: boolean;
}
const { entry, visual = false } = Astro.props;
const note = entry.collection === 'notes';
---

<article
  class:list={['entry-card', { 'with-visual': visual, 'note-entry': note }]}
  data-entry-tags={JSON.stringify(entry.data.tags)}
>
  <div class="entry-card-body">
    <div class="entry-meta">
      <span class:list={['category', { 'category-note': note }]}>{note ? '系列筆記' : '文章'}</span>
      {entry.data.sample && <span class="sample-label">示範內容</span>}
      <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
    </div>
    <h3>
      <a class="entry-title" href={entryUrl(entry)}>
        {entry.data.title}
      </a>
    </h3>
    <p>{entry.data.description}</p>
    <div class="entry-card-bottom">
      <div class="tags">
        {entry.data.tags
          .slice(0, 3)
          .map((tag) =>
            note ? <span>{tag}</span> : <a href={`/blog/?tag=${encodeURIComponent(tag)}`}>{tag}</a>,
          )}
      </div>
      <span class="read-time">
        約 {readingTime(entry.body)} 分鐘 <Icon name="arrow" size={17} />
      </span>
    </div>
  </div>
</article>
