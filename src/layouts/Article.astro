---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from './Base.astro';
import { entryUrl, formatDate, readingTime, type Entry } from '../lib/content';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
interface Props {
  entry: Entry;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const label = entry.collection === 'notes' ? '實作筆記' : '文章';
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<Base title={entry.data.title} description={entry.data.description} article date={entry.data.date}>
  <div class="container article-container">
    <a class="back-link" href={`/${entry.collection}/`}>
      ← 返回{label}
    </a>
    <article data-pagefind-body>
      <header class="article-heading">
        <div class="entry-meta">
          <span
            class:list={['category', { 'category-note': entry.collection === 'notes' }]}
            data-pagefind-meta="type"
          >
            {label}
          </span>
          {entry.data.sample && <span class="sample-label">示範內容</span>}
          <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          <span>約 {readingTime(entry.body)} 分鐘閱讀</span>
        </div>
        <h1 data-pagefind-meta="title">{entry.data.title}</h1>
        <p class="article-description" data-pagefind-meta="description">
          {entry.data.description}
        </p>
        <p class="article-byline" data-pagefind-ignore>
          <a href="/cv/">{profile.name}</a>
          <span aria-hidden="true">／</span>未完筆記
        </p>
        <div class="tags article-tags">
          {entry.data.tags.map((tag) => (
            <a href={`/${entry.collection}/?tag=${encodeURIComponent(tag)}`}>{tag}</a>
          ))}
        </div>
      </header>
      {entry.data.sample && (
        <aside class="sample-notice" data-pagefind-ignore>
          這是一篇示範內容，用來展示文章格式，並非網站作者的個人經歷或研究成果。
        </aside>
      )}
      <div class="article-grid">
        <div class="prose">
          <Content />
        </div>
        {toc.length > 0 && (
          <aside class="toc" data-pagefind-ignore>
            <nav aria-label="文章目錄">
              <span class="eyebrow">CONTENTS</span>
              <h2>文章目錄</h2>
              <ul>
                {toc.map((heading) => (
                  <li class:list={{ 'toc-sub': heading.depth === 3 }}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
      </div>
      <div class="article-end" data-pagefind-ignore>
        <span>讀到這裡，再帶走一個問題。</span>
        <a class="text-link" href={`/${entry.collection}/`}>
          更多{label} <Icon name="arrow" size={17} />
        </a>
      </div>
    </article>
    <link itemprop="url" href={entryUrl(entry)} />
  </div>
</Base>
