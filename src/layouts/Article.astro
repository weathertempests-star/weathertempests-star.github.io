---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from './Base.astro';
import {
  entryUrl,
  formatDate,
  readingTime,
  published,
  publishedSeries,
  seriesUrl,
  type Entry,
} from '../lib/content';
import Icon from '../components/Icon.astro';
import Mermaid from '../components/Mermaid.astro';
import PaperInfo from '../components/PaperInfo.astro';
import SeriesNavigation from '../components/SeriesNavigation.astro';
import EntryCard from '../components/EntryCard.astro';
import { profile } from '../data/profile';
interface Props {
  entry: Entry;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const label = entry.collection === 'notes' ? '系列筆記' : '文章';
const series =
  entry.collection === 'notes'
    ? (await publishedSeries()).find((item) => item.id === entry.data.series.id)
    : undefined;
const chapterIndex = series?.chapters.findIndex((chapter) => chapter.id === entry.id) ?? -1;
const previous = series?.chapters[chapterIndex - 1];
const next = series?.chapters[chapterIndex + 1];
const related =
  entry.collection === 'blog'
    ? (await published('blog'))
        .filter(
          (other) =>
            other.id !== entry.id && other.data.tags.some((tag) => entry.data.tags.includes(tag)),
        )
        .sort(
          (a, b) =>
            b.data.tags.filter((tag) => entry.data.tags.includes(tag)).length -
            a.data.tags.filter((tag) => entry.data.tags.includes(tag)).length,
        )
        .slice(0, 3)
    : [];
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<Base title={entry.data.title} description={entry.data.description} article date={entry.data.date}>
  <div class="container article-container">
    <a class="back-link" href={series ? seriesUrl(series.id) : '/blog/'}>
      ← {series ? `返回${series.title}系列目錄` : '返回文章列表'}
    </a>
    <article data-pagefind-body>
      <header class="article-heading">
        <div class="entry-meta">
          <span
            class:list={['category', { 'category-note': entry.collection === 'notes' }]}
            data-pagefind-meta="type"
          >
            {label}
          </span>
          {entry.data.sample && <span class="sample-label">示範內容</span>}
          <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          <span>約 {readingTime(entry.body)} 分鐘閱讀</span>
        </div>
        <h1 data-pagefind-meta="title">{entry.data.title}</h1>
        <p class="article-description" data-pagefind-meta="description">
          {entry.data.description}
        </p>
        <p class="article-byline" data-pagefind-ignore>
          <a href="/cv/">{profile.name}</a>
          <span aria-hidden="true">／</span>未完筆記
        </p>
        <div class="tags article-tags">
          {entry.data.tags.map((tag) =>
            entry.collection === 'blog' ? (
              <a href={`/blog/?tag=${encodeURIComponent(tag)}`}>{tag}</a>
            ) : (
              <span>{tag}</span>
            ),
          )}
        </div>
      </header>
      {entry.collection === 'blog' && entry.data.paper && <PaperInfo paper={entry.data.paper} />}
      {series && <SeriesNavigation series={series} currentId={entry.id} />}
      {entry.data.sample && (
        <aside class="sample-notice" data-pagefind-ignore>
          這是一篇示範內容，用來展示文章格式，並非網站作者的個人經歷或研究成果。
        </aside>
      )}
      <div class="article-grid">
        <div class="prose">
          <Content />
        </div>
        {toc.length > 0 && (
          <aside class="toc" data-pagefind-ignore>
            <details class="toc-disclosure" open>
              <summary>文章目錄</summary>
              <nav aria-label="文章目錄">
                <ul>
                  {toc.map((heading) => (
                    <li class:list={{ 'toc-sub': heading.depth === 3 }}>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
          </aside>
        )}
      </div>
      {series ? (
        <div class="series-reading-end" data-pagefind-ignore>
          {(previous || next) && (
            <nav class="chapter-pagination" aria-label="篇章導覽">
              {previous && (
                <a rel="prev" href={entryUrl(previous)}>
                  <span>← 上一篇</span>
                  <strong>{previous.data.title}</strong>
                </a>
              )}
              {next && (
                <a rel="next" href={entryUrl(next)}>
                  <span>下一篇 →</span>
                  <strong>{next.data.title}</strong>
                </a>
              )}
            </nav>
          )}
          {!next && <p class="muted">你已讀到這個系列目前發布的最後一篇。</p>}
          <div class="article-end">
            <a class="text-link" href={seriesUrl(series.id)}>
              返回系列目錄 →
            </a>
            <a class="text-link" href="/notes/">
              探索其他系列 →
            </a>
          </div>
        </div>
      ) : (
        <div class="article-end" data-pagefind-ignore>
          <span>沿著感興趣的主題，繼續探索。</span>
          <a
            class="text-link"
            href={`/blog/${entry.data.tags[0] ? `?tag=${encodeURIComponent(entry.data.tags[0])}` : ''}`}
          >
            更多{entry.data.tags[0] || ''}文章 <Icon name="arrow" size={17} />
          </a>
        </div>
      )}
    </article>
    {related.length > 0 && (
      <section class="related-articles" aria-labelledby="related-heading" data-pagefind-ignore>
        <h2 id="related-heading">接著探索相同主題</h2>
        <div class="research-grid">
          {related.map((other) => (
            <EntryCard entry={other} />
          ))}
        </div>
      </section>
    )}
    <link itemprop="url" href={entryUrl(entry)} />
  </div>
</Base>
<Mermaid />
<script>
  const toc = document.querySelector<HTMLDetailsElement>('.toc-disclosure');
  if (toc) {
    const mobile = window.matchMedia('(max-width: 760px)');
    const update = () => {
      toc.open = !mobile.matches;
    };
    update();
    mobile.addEventListener('change', update);
  }
</script>
