---
import '../styles/global.css';
import '@fontsource-variable/noto-sans-tc';
import { profile } from '../data/profile';
import Icon from '../components/Icon.astro';
interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  noindex?: boolean;
  date?: Date;
}
const {
  title,
  description = profile.description,
  article = false,
  noindex = false,
  date,
} = Astro.props;
const pageTitle = title
  ? `${title} — ${profile.siteName}`
  : `${profile.siteName} — ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { label: '首頁', path: '/' },
  { label: '文章', path: '/blog/' },
  { label: '研究筆記', path: '/notes/' },
  { label: '關於', path: '/cv/' },
];
const active = (path: string) =>
  path === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(path);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F4EC" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {article && <meta name="author" content={profile.name} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={profile.siteName} />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profile.siteName} RSS`}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳至主要內容
    </a>
    <header class="site-header" data-pagefind-ignore>
      <div class="header-inner">
        <a href="/" class="brand" aria-label={`${profile.siteName} 首頁`}>
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none">
              <path d="M14 16H34M10 23H38M24 10V38M24 23L11 36M24 23L37 36" />
            </svg>
          </span>
          <span>
            {profile.siteName}
            <small>NOTES IN PROGRESS</small>
          </span>
        </a>
        <nav aria-label="主要導覽">
          {nav.map(({ label, path }) => (
            <a href={path} aria-current={active(path) ? 'page' : undefined}>
              {label}
            </a>
          ))}
        </nav>
        <a
          href="/search/"
          class:list={['search-link', { selected: active('/search/') }]}
          aria-label="搜尋文章與筆記"
        >
          <Icon name="search" />
          <span>搜尋</span>
        </a>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="footer-inner">
        <div>
          <a class="footer-brand" href="/">
            {profile.siteName}
            <span class="blue">.</span>
          </a>
          <p>從一個問題開始，把想法寫清楚。</p>
        </div>
        <div class="footer-links">
          <a href="/blog/">閱讀文章</a>
          <a href="/cv/">關於未完</a>
          <a href="/rss.xml">
            <Icon name="rss" size={14} /> RSS 訂閱
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>
          © {new Date().getFullYear()} {profile.siteName}
        </span>
        <span>每一篇，都是下一個問題的起點。</span>
      </div>
    </footer>
  </body>
</html>
