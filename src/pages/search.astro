---
import Base from '../layouts/Base.astro';
import { published } from '../lib/content';
const dev = import.meta.env.DEV;
const entries = [...(await published('blog')), ...(await published('notes'))];
---

<Base title="搜尋" noindex>
  <div class="container page-container search-page">
    <header class="page-heading">
      <div class="eyebrow">FIND AN IDEA</div>
      <h1>
        尋找一個想法<span class="blue">.</span>
      </h1>
      <p>搜尋文章與研究筆記，接續你的探索。</p>
    </header>
    <div class="search-panel">
      {!entries.length ? (
        <p class="empty-state">還沒有已發布的文章或研究筆記。第一篇記錄，正在醞釀中。</p>
      ) : dev ? (
        <p class="empty-state">
          本機開發模式不建立搜尋索引。請執行 npm run build，再以 npm run preview 測試全文搜尋。
        </p>
      ) : (
        <>
          <div id="search"></div>
          <p id="search-status" class="muted" role="status" hidden></p>
          <p id="search-fallback">
            全文搜尋需要 JavaScript。你也可以瀏覽<a href="/blog/">文章</a>或
            <a href="/notes/">研究筆記</a>。
          </p>
          <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
          <script is:inline src="/pagefind/pagefind-ui.js" defer></script>
          <script is:inline>
            window.addEventListener('DOMContentLoaded', () => {
              const status = document.getElementById('search-status');
              try {
                new PagefindUI({
                  element: '#search',
                  showSubResults: true,
                  showImages: false,
                  resetStyles: false,
                  translations: {
                    placeholder: '搜尋文章、筆記或關鍵字…',
                    clear_search: '清除',
                    load_more: '載入更多結果',
                    search_label: '搜尋文章與研究筆記',
                    searching: '搜尋中…',
                    zero_results: '找不到「[SEARCH_TERM]」的相關內容，試試其他關鍵字。',
                    one_result: '找到 [COUNT] 筆「[SEARCH_TERM]」的結果',
                    many_results: '找到 [COUNT] 筆「[SEARCH_TERM]」的結果',
                    alt_search: '找不到「[SEARCH_TERM]」的結果，改為顯示「[DIFFERENT_TERM]」的結果',
                    search_suggestion: '找不到「[SEARCH_TERM]」的結果，請嘗試：',
                  },
                });
                document.getElementById('search-fallback').hidden = true;
                status.hidden = true;
              } catch {
                status.hidden = false;
                status.textContent =
                  '搜尋暫時無法載入，請重新整理，或從文章與研究筆記列表繼續閱讀。';
              }
            });
          </script>
        </>
      )}
    </div>
    <div class="search-hints">
      <span>也可以直接瀏覽</span>
      <a href="/blog/">文章 →</a>
      <a href="/notes/">研究筆記 →</a>
    </div>
  </div>
</Base>
