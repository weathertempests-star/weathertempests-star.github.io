---
import Base from '../layouts/Base.astro';
import EntryCard from '../components/EntryCard.astro';
import SeriesCard from '../components/SeriesCard.astro';
import { published, publishedSeries } from '../lib/content';
const [blog, series] = await Promise.all([published('blog'), publishedSeries()]);
const topics = ['Agent 系統', '模型訓練', 'AI 安全', '機密運算'].filter((tag) =>
  blog.some((entry) => entry.data.tags.includes(tag)),
);
---

<Base>
  <div class="container">
    <section class="journal-intro" aria-labelledby="hero-title">
      <div class="eyebrow">
        <span class="tiny-line"></span> NOTES IN PROGRESS
      </div>
      <h1 id="hero-title">
        從好奇的問題，
        <br />
        讀進技術裡<span class="blue">。</span>
      </h1>
      <p class="lead">
        讀論文，理解方法與證據。寫筆記，把概念連到實作。
        <br />
        選一個感興趣的領域，或沿著系列慢慢深入。
      </p>
    </section>
    <nav class="reading-paths" aria-label="選擇閱讀方式">
      <a href="/blog/" class="reading-path">
        <span class="eyebrow">EXPLORE BY TOPIC</span>
        <h2>
          依主題探索文章 <span aria-hidden="true">→</span>
        </h2>
        <p>從標籤找到感興趣的領域。每篇都能獨立閱讀，再沿著相關文章繼續探索。</p>
        <span class="small">{blog.length} 篇文章</span>
      </a>
      <a href="/notes/" class="reading-path">
        <span class="eyebrow">FOLLOW A SERIES</span>
        <h2>
          沿系列閱讀筆記 <span aria-hidden="true">→</span>
        </h2>
        <p>把同一個主題接著讀下去。依章節順序理解概念、實作方法與研究過程。</p>
        <span class="small">{series.length} 個系列</span>
      </a>
    </nav>
    <section class="home-articles section-block" aria-labelledby="articles-heading">
      <div class="section-heading">
        <div>
          <div class="eyebrow">LATEST ARTICLES</div>
          <h2 id="articles-heading">最近的文章</h2>
        </div>
        <a class="text-link" href="/blog/">
          所有文章 →
        </a>
      </div>
      <div class="home-topic-links" aria-label="文章主題">
        {topics.map((tag) => (
          <a href={`/blog/?tag=${encodeURIComponent(tag)}`}>
            {tag}
            <span aria-hidden="true"> →</span>
          </a>
        ))}
      </div>
      {blog.length ? (
        <div class="research-grid">
          {blog.slice(0, 3).map((entry) => (
            <EntryCard entry={entry} />
          ))}
        </div>
      ) : (
        <p class="empty-state">第一篇文章正在整理中。</p>
      )}
    </section>
    <section class="home-series section-block" aria-labelledby="series-heading">
      <div class="section-heading">
        <div>
          <div class="eyebrow">READ IN SEQUENCE</div>
          <h2 id="series-heading">沿著系列深入</h2>
        </div>
        <a class="text-link" href="/notes/">
          所有系列 →
        </a>
      </div>
      <div class="series-grid">
        {series.map((item) => (
          <SeriesCard series={item} />
        ))}
      </div>
      {!series.length && <p class="empty-state">第一個系列正在整理中。</p>}
    </section>
    <div class="home-closing">
      <p>未完筆記，由人與 AI 共同整理的技術閱讀與學習紀錄。</p>
      <a href="/cv/">認識未完 →</a>
      <a href="/rss.xml">RSS 訂閱 →</a>
    </div>
  </div>
</Base>
