---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import EntryCard from '../components/EntryCard.astro';
import { profile } from '../data/profile';
import { published, entryUrl, formatDate, readingTime } from '../lib/content';

const [blog, notes] = await Promise.all([published('blog'), published('notes')]);
const entries = [...blog, ...notes].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || entryUrl(a).localeCompare(entryUrl(b)),
);
const leadEntry = entries.find((entry) => entry.data.featured) ?? entries[0];
const moreEntries = entries.filter((entry) => entry !== leadEntry).slice(0, 4);
const topics = new Map<string, string>();
for (const entry of entries) {
  for (const tag of entry.data.tags) {
    if (!topics.has(tag)) topics.set(tag, `/${entry.collection}/?tag=${encodeURIComponent(tag)}`);
  }
}
---

<Base>
  <div class="container">
    <section class="journal-intro" aria-labelledby="hero-title">
      <div class="eyebrow">
        <span class="tiny-line"></span> NOTES IN PROGRESS
      </div>
      <h1 id="hero-title">
        和 AI 一起，
        <br />
        把想法做成作品<span class="blue">。</span>
      </h1>
      <p class="lead">
        從一份說清楚的委託，到一段查得回來源的文字。
        <br />
        記下創作的判斷，也留下可以重做的步驟。
      </p>
      <div class="author-line">
        <span>{profile.name}的創作與實驗筆記</span>
        <span aria-hidden="true">／</span>
        <a href="/cv/">
          認識作者 <Icon name="arrow" size={15} />
        </a>
      </div>
    </section>

    <section class="home-feature" aria-labelledby="feature-heading">
      <div class="section-heading">
        <div>
          <div class="eyebrow">START HERE</div>
          <h2 id="feature-heading">從一個問題開始</h2>
        </div>
        <span class="small muted">本期主題 · 把 AI 提案變成作品</span>
      </div>
      {leadEntry ? (
        <article class="feature-story">
          <div class="feature-copy">
            <div class="entry-meta">
              <span class="category">{leadEntry.collection === 'notes' ? '實作筆記' : '文章'}</span>
              {leadEntry.data.sample && <span class="sample-label">示範內容</span>}
              <time datetime={leadEntry.data.date.toISOString()}>
                {formatDate(leadEntry.data.date)}
              </time>
              <span>約 {readingTime(leadEntry.body)} 分鐘閱讀</span>
            </div>
            <h3>
              <a class="entry-title" href={entryUrl(leadEntry)}>
                {leadEntry.data.title}
              </a>
            </h3>
            <p>{leadEntry.data.description}</p>
            <a class="text-link" href={entryUrl(leadEntry)}>
              閱讀這篇文章 <Icon name="arrow" size={18} />
            </a>
          </div>
          <div class="feature-index" aria-label="本期閱讀路線">
            <span class="eyebrow">THE MAKING OF AN IDEA</span>
            <p>
              從提問，
              <br />
              走到完成。
            </p>
            <ol>
              <li>把需求說清楚</li>
              <li>回頭核對證據</li>
              <li>讓程式通過檢驗</li>
            </ol>
          </div>
        </article>
      ) : (
        <p class="empty-state">第一篇作品正在整理中。你可以先認識這個網站的創作方向。</p>
      )}
    </section>

    {moreEntries.length > 0 && (
      <section class="home-reading section-block" aria-labelledby="reading-heading">
        <div class="section-heading">
          <div>
            <div class="eyebrow">KEEP EXPLORING</div>
            <h2 id="reading-heading">接著讀</h2>
          </div>
          <a class="text-link" href="/blog/">
            所有文章 <Icon name="arrow" size={17} />
          </a>
        </div>
        <div class="featured-grid">
          {moreEntries.map((entry) => (
            <EntryCard entry={entry} />
          ))}
        </div>
      </section>
    )}

    <div class="home-bottom">
      <section class="topic-section" aria-labelledby="topics-heading">
        <div class="eyebrow">QUESTIONS WORTH KEEPING</div>
        <h2 id="topics-heading">追問的方向</h2>
        <p>寫作、工具與小型實驗之間，總有值得再走一步的地方。</p>
        <div class="topic-list">
          {[...topics].slice(0, 8).map(([tag, url]) => (
            <a href={url}>
              {tag} <Icon name="arrow" size={15} />
            </a>
          ))}
        </div>
      </section>
      <aside class="about-card">
        <span class="eyebrow">A NOTE FROM THE AUTHOR</span>
        <h2>我是{profile.name}。</h2>
        <p>這裡收集創作中需要停下來想一想的時刻：怎麼提問、憑什麼相信，以及怎樣才算完成。</p>
        <a class="text-link" href="/cv/">
          關於未完筆記 <Icon name="arrow" size={17} />
        </a>
        <div class="about-rule"></div>
        <p class="small muted">用你習慣的 RSS 閱讀器，追蹤新文章。</p>
        <a class="text-link" href="/rss.xml">
          <Icon name="rss" size={16} /> RSS 訂閱
        </a>
      </aside>
    </div>
  </div>
</Base>
