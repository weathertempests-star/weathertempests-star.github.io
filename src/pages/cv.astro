---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
const sections = [
  {
    id: 'education',
    title: '學歷',
    english: 'EDUCATION',
    entries: profile.education,
    placeholder: '待填：學校、系所、學位與就讀期間。',
  },
  {
    id: 'experience',
    title: '經歷',
    english: 'EXPERIENCE',
    entries: profile.experience,
    placeholder: '待填：職稱、組織、期間及主要工作內容。',
  },
  {
    id: 'publications',
    title: '研究成果',
    english: 'PUBLICATIONS & PROJECTS',
    entries: profile.publications,
    placeholder: '待填：論文、專案、發表年份及相關連結。',
  },
];
---

<Base title="關於與履歷">
  <div class="container page-container cv-page">
    <header class="page-heading cv-heading">
      <div>
        <div class="eyebrow">A LITTLE ABOUT ME</div>
        <h1>
          關於與履歷<span class="blue">.</span>
        </h1>
        <p>每一次學習與探索，都成為下一步的起點。</p>
      </div>
      <button class="button secondary" id="print-cv" type="button" hidden>
        <Icon name="print" size={17} /> 列印 / 另存 PDF
      </button>
    </header>
    <div class="cv-grid">
      <aside class="profile-card">
        <div class="profile-avatar" aria-hidden="true">
          <span>
            hello<span class="blue">.</span>
          </span>
        </div>
        <h2>{profile.name}</h2>
        <p class="muted">{profile.role}</p>
        <div class="profile-divider"></div>
        <span class="eyebrow">RESEARCH INTERESTS</span>
        <h3>研究領域</h3>
        {profile.interests.length > 0 ? (
          <div class="tags">
            {profile.interests.map((interest) => (
              <span>{interest}</span>
            ))}
          </div>
        ) : (
          <p class="placeholder">待填：研究領域與興趣</p>
        )}
        {(profile.email || profile.links.length > 0) && (
          <div class="profile-contact">
            {profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}
            {profile.links
              .filter((link) => link.url)
              .map((link) => (
                <a href={link.url} rel="me">
                  {link.label}
                  <Icon name="external" size={14} />
                </a>
              ))}
          </div>
        )}
        <a class="text-link" href="/notes/">
          我的研究筆記 <Icon name="arrow" size={16} />
        </a>
      </aside>
      <div class="cv-content">
        <section class="cv-section">
          <div class="eyebrow">INTRODUCTION</div>
          <h2>自我介紹</h2>
          <p>{profile.bio}</p>
        </section>
        {sections.map((section) => (
          <section class="cv-section" id={section.id}>
            <div class="eyebrow">{section.english}</div>
            <h2>{section.title}</h2>
            {section.entries.length ? (
              <div class="timeline">
                {section.entries.map((entry) => (
                  <div class="timeline-entry">
                    <span class="timeline-date">{entry.period}</span>
                    <h3>{entry.url ? <a href={entry.url}>{entry.title} ↗</a> : entry.title}</h3>
                    <p class="organization">{entry.organization}</p>
                    <p>{entry.description}</p>
                  </div>
                ))}
              </div>
            ) : (
              <p class="placeholder-block">{section.placeholder}</p>
            )}
          </section>
        ))}
        <section class="cv-section">
          <div class="eyebrow">TOOLKIT</div>
          <h2>技能</h2>
          {profile.skills.length ? (
            profile.skills.map((skill) => (
              <div class="skill-group">
                <h3>{skill.category}</h3>
                <div class="tags">
                  {skill.items.map((item) => (
                    <span>{item}</span>
                  ))}
                </div>
              </div>
            ))
          ) : (
            <p class="placeholder-block">待填：專業技能、研究工具與語言能力。</p>
          )}
        </section>
      </div>
    </div>
  </div>
</Base>
<script>
  const printButton = document.querySelector<HTMLButtonElement>('#print-cv');
  if (printButton) {
    printButton.hidden = false;
    printButton.addEventListener('click', () => window.print());
  }
</script>
